{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Archivist",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "Archivist",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "allowlist": {
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "me.geso.archivist"
    }
  }
}